# dola キューシート — pasta DSL 拡張設計仕様 (v3)
# ===========================================================================
# 【免責】本ファイルは pasta DSL 拡張仕様（dola-cue-pasta-dsl-extension）の
#          全機能網羅サンプルです。
#          現行の pasta_core ではコンパイルできません（拡張実装が完了してから
#          使用可能になります）。
#
# 拡張文法の 3 つの柱：
#   1. キューシートモード  &type:cuesheet — シーン単位で拡張構文を有効化
#   2. ! キューコマンド行  !keyframe / !wait_input 等 — 時系列・バリア制御
#   3. エイリアス定義行   @alias = Emote(key) 等 — CueCommand の名前付き定義
#
# ルーティング（RouteAdd）はアクション行の初出現から自動生成されます。
# スロット割り当ては %actor=slot で明示でき、省略時は自動採番されます。
# ===========================================================================

# ---------------------------------------------------------------------------
# シーン 1: 基本キューシート — テキスト・エイリアス・Barrier・Clear の基礎パターン
# ---------------------------------------------------------------------------
# 要件カバレッジ: 1.1, 2.1–2.6, 3.1–3.3, 3.11, 4.1, 4.2, 4.5, 4.6,
#                5.1, 5.2, 5.4, 6.1, 6.2, 7.1, 9.1, 9.3

＊起動挨拶
    ＆type：cuesheet

    # --- アクター配置（スロット明示割り当て） ---
    # %actor=slot_id  →  SlotRegistry::assign_explicit(さくら, 0)
    %さくら=0

    # --- エイリアス定義行 ---
    # @alias名 = CueCommand(引数)  →  シーンスコープで有効（要件 4.1, 4.2）
    @普通 = Emote(normal)
    @笑顔 = Emote(smile)
    @はい = Choice(yes, "はい、行きましょう！")
    @いいえ = Choice(no, "今日は遠慮します")

    # --- アクション行（暗黙キーフレーム方式）---
    # アクター初出現時に RouteAdd が自動生成される（要件 6.1, 6.2）
    さくら：@普通
    さくら：こんにちは！今日はいい天気ですね。
    # 継続行（\n 結合で同一 Cue::Text に追記される）（要件 5.4）
    ：お散歩の季節ですね。

    # --- キーフレームに名前を付ける ---
    # !keyframe <name>  →  current_time に名前を登録（要件 3.3）
    !keyframe 挨拶後

    # --- 表情変更 ---
    # @笑顔 はエイリアス定義済みなので Emote(smile) に展開される（要件 4.5）
    さくら：@笑顔
    さくら：お散歩でも行きませんか？

    # --- 入力待ちバリア（タイムアウト 10 秒）---
    # !wait_input[秒]  →  BarrierKind::WaitForInput { timeout: Some(10.0) }（要件 3.3）
    !wait_input[10.0]

    # --- バルーンクリア + 選択肢先積み + 選択肢待ちバリア ---
    # !clear は明示記述時のみ CueCommand::Clear を生成（要件 3.11）
    !clear
    さくら：@はい
    さくら：@いいえ
    # !wait_choice[秒]  →  BarrierKind::WaitForChoice { timeout: Some(30.0) }（要件 3.3）
    !wait_choice[30.0]

    # --- 未定義エイリアスの Emote フォールバックデモ ---
    # @happy は定義されていないが Emote { key: "happy" } にフォールバック（要件 4.6, 5.2）
    さくら：@happy よかった！


# ---------------------------------------------------------------------------
# シーン 2: 並列演出 — 2 アクターが同一基準時刻から発話するパターン
# ---------------------------------------------------------------------------
# 要件カバレッジ: 3.3, 3.9, 3.10, 6.1–6.4, 9.1, 9.2

＊デュエット挨拶
    ＆type：cuesheet

    # --- アクター配置（2 アクター）---
    %さくら=0
    %うにゅう=1

    # --- エイリアス定義 ---
    @うれしい = Emote(happy)
    @はにかみ = Emote(shy)

    # --- 逐次発話（暗黙キーフレームが順に進む）---
    さくら：こんにちはー！
    うにゅう：ごきげんよう！

    # --- キーフレーム宣言 ---
    # 直前の暗黙キーフレームに "会話開始" という名前を付ける
    !keyframe 会話開始

    # --- 並列演出: 同一基準時刻 "会話開始" から両アクターが同時発話 ---
    # !@<name>  →  current_time = keyframe["会話開始"]（要件 3.9）
    # 同一基準時刻の複数エントリ = 並列演出として別々の Cue に変換（要件 3.10）
    !@会話開始
    さくら：ねえ、何か食べに行かない？

    !@会話開始
    うにゅう：いいですわね、ケーキはいかが？

    # --- オフセット付きキーフレーム参照 ---
    # !@<name>+<秒>  →  current_time = keyframe["会話開始"] + 1.0（要件 3.5, 3.9）
    !@会話開始+1.0
    さくら：@うれしい
    さくら：決まりだね！

    !@会話開始+1.0
    うにゅう：@はにかみ
    うにゅう：では参りましょう。

    # --- タイムアウトバリア ---
    # !timeout[秒]  →  BarrierKind::Timeout { duration: 2.0 }（要件 3.3）
    !timeout[2.0]

    # --- ルート削除（明示記述時のみ発行）---
    # !route_remove[target]  →  RoutingCommand::RouteRemove { target }（要件 3.3）
    !route_remove[balloon]


# ---------------------------------------------------------------------------
# シーン 3: 1 行内複数 @command — テキスト断片と CueCommand の交互生成
# ---------------------------------------------------------------------------
# 要件カバレッジ: 5.6

＊表情豊かな発話
    ＆type：cuesheet

    %さくら=0

    @驚き = Emote(surprised)
    @笑顔 = Emote(smile)

    # 1 行に複数 @command を含む場合、出現順に Text/Emote が交互に生成される
    # Text("ふふーんいいでしょ。"), Emote(smile), Text("あ！"), Emote(surprised)
    さくら：ふふーんいいでしょ。@笑顔　あ！@驚き


# ---------------------------------------------------------------------------
# シーン 5: 明示 !route_add / !route_switch — EntityKey 個別指定
# ---------------------------------------------------------------------------
# 要件カバレッジ: 6.3, 6.4, 6.9
# %actor=slot ではなく、!route_add で Shell/Balloon を別々の Entity に向ける例

＊舞台演出
    ＆type：cuesheet

    # --- Shell はスロット0 の通常位置、Balloon は舞台上の Spot バルーン ---
    # !route_add[target, entity_key]  →  RoutingCommand::RouteAdd（要件 6.3）
    !route_add[shell, actor:さくら:shell]
    !route_add[balloon, spot:stage_balloon]

    さくら：ここは舞台の上ですわ！

    # --- シーン途中でバルーンの配信先を切り替える ---
    # !route_switch[target, entity_key]  →  RoutingCommand::RouteSwitch（要件 6.4）
    !route_switch[balloon, actor:さくら:balloon]

    さくら：通常バルーンに戻りましたわ。

    # --- RouteAdd は同一 target に複数 entity を登録しての多重配信には使えない ---
    # （RouteAdd は target に対して 1:1 のマッピング）


# ---------------------------------------------------------------------------
# 通常 pasta シーン（キューシートモード外）— 後方互換性の確認
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# 要件カバレッジ: 7.1, 7.2, 7.3
# &type:cuesheet が付いていないため ! / @ は拡張構文として解釈されない

＊通常会話
    さくら：こちらはキューシートモードではありません。
    さくら：!keyframe のような行も通常テキストとして扱われます。
    さくら：@happy も通常の pasta ランダムワード参照として動作します。
